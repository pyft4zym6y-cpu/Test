{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/manage",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/system",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/systems",
      "destination": "/#systems",
      "permanent": true
    },
    {
      "source": "/loss",
      "destination": "/diagnose",
      "permanent": true
    },
    {
      "source": "/classic",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cases",
      "destination": "/proof",
      "permanent": true
    },
    {
      "source": "/cases/:slug*",
      "destination": "/proof",
      "permanent": true
    },
    {
      "source": "/challenges",
      "destination": "/#systems",
      "permanent": true
    },
    {
      "source": "/what-we-build",
      "destination": "/#systems",
      "permanent": true
    },
    {
      "source": "/what-we-build/eu-expansion",
      "destination": "/expansion",
      "permanent": true
    },
    {
      "source": "/expansion/web",
      "destination": "/expansion/technology",
      "permanent": true
    },
    {
      "source": "/en/expansion/web",
      "destination": "/en/expansion/technology",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/#systems",
      "permanent": true
    },
    {
      "source": "/how-it-works/business-health",
      "destination": "/diagnose",
      "permanent": true
    },
    {
      "source": "/how-it-works/independence-score",
      "destination": "/diagnose",
      "permanent": true
    },
    {
      "source": "/how-it-works/benchmark",
      "destination": "/diagnose",
      "permanent": true
    },
    {
      "source": "/intelligence",
      "destination": "/proof",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/people",
      "permanent": true
    },
    {
      "source": "/about/founder",
      "destination": "/people",
      "permanent": true
    },
    {
      "source": "/about/team",
      "destination": "/people",
      "permanent": true
    },
    {
      "source": "/about/standard",
      "destination": "/people",
      "permanent": true
    },
    {
      "source": "/diagnose/full",
      "destination": "/diagnose",
      "permanent": true
    }
  ]
}
